<!DOCTYPE html>
<html lang="pl">

<head>

    <meta charset="UTF-8">
    <title>{{title}}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description" content="{{description}}">

    <meta name="author" content="{{author}}">
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            margin: 40px;
        }

        .Lbl {
            -webkit-pdf-tag-type: Lbl;
            -webkit-pdf-artifact: yes;
            display: inline-block;
            width: 1.2em;
            text-align: left;
        }

        .LBody {
            -webkit-pdf-tag-type: LBody;
        }

        aside {
            -webkit-pdf-tag-type: Note;
        }

        h1 {
            -webkit-pdf-tag-type: H1;
            color: #2c3e50;
        }

        h2 {
            -webkit-pdf-tag-type: H2;
            color: #2c3e50;
        }

        h3 {
            -webkit-pdf-tag-type: H3;
            color: #2c3e50;
        }

        h4 {
            -webkit-pdf-tag-type: H4;
            color: #2c3e50;
        }

        header,
        footer,
        nav,
        main,
        section,
        article,
        aside {
            display: block;
        }

        header {
            -webkit-pdf-artifact: yes;
        }

        footer {
            -webkit-pdf-artifact: yes;
        }

        footer p,
        footer a {
            -webkit-pdf-tag-type: P;
        }

        nav ul {
            list-style: none;
            padding: 0;
        }

        nav li {
            margin-bottom: 5px;
        }

        ul {
            list-style: none;
            list-style-position: inside;
            padding-left: 0;
        }

        li {
            list-style-type: none;
        }

        a {
            color: #2980b9;
            text-decoration: none;
        }

        a:hover,
        a:focus {
            text-decoration: underline;
        }

        figure {
            display: block;
            width: 100%;
            min-height: 180px;
            margin: 20px auto;
            text-align: center;
        }

        figure img {
            display: block;
            width: 400px;
            max-width: 80%;
            height: auto;
            min-height: 150px;
            margin: 0 auto;
            border: 1px solid #000000;
            -webkit-pdf-artifact: yes;
        }

        img {
            max-width: 100%;
            height: auto;
            border: 1px solid #000000;
            -webkit-pdf-artifact: yes;
        }

        figcaption {
            font-size: 0.9em;
            color: #555;
            text-align: center;
            margin-top: 8px;
            -webkit-pdf-tag-type: Caption;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }

        th,
        td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: left;
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            border: 0;
            -webkit-pdf-artifact: yes;
        }

        nav[role="navigation"] {
            margin-bottom: 40px;
        }

        nav[role="navigation"] ul {
            list-style: none;
            padding-left: 0;
        }

        nav[role="navigation"] li {
            display: flex;
            justify-content: space-between;
        }

        .TOC-Label {
            font-weight: bold;
            white-space: nowrap;
        }

        .TOC-Leader {
            flex-grow: 1;
            overflow: hidden;
            white-space: nowrap;
            margin: 0 4px;
            font-size: 0.8em;
        }

        .TOC-PageNumber {
            white-space: nowrap;
        }
    </style>
</head>

<body>
    <h1 id="doc-title">{{title}}</h1>

    <nav role="navigation" aria-label="Spis treści" -webkit-pdf-tag-type="TOC">
        <h2 -webkit-pdf-tag-type="H2">Spis Treści</h2>

        <div style="display:flex; flex-direction:column; gap:4px;">
            {{#each sections}}
            <p -webkit-pdf-tag-type="P" style="margin:0; padding:0;">
                <!--
        - title => pomaga wstawieniu Contents w anotacji
        - aria-label => zapewnia Alt w strukturze, zależnie od generatora
        - -webkit-pdf-tag-type="Link" => wymusza utworzenie strukturalnego elementu Link
      -->
                <a href="#section-{{@index}}" title="Przejdź do sekcji: {{heading}}"
                    aria-label="Przejdź do sekcji: {{heading}}" -webkit-pdf-tag-type="Link"
                    style="text-decoration:none; color:#2c3e50; display:inline-block; width:calc(100% - 40px);">
                    {{heading}}
                </a>

                <!-- numer strony jako oddzielny element (nie artefakt) -->
                <span style="float:right; width:40px; text-align:right; display:inline-block;">{{pageNumber}}</span>
            </p>
            {{/each}}
        </div>
    </nav>


    <hr>

    {{!-- GŁÓWNA TREŚĆ DOKUMENTU --}}
    <main role="main" aria-labelledby="main-title">
        <h2 id="main-title" class="sr-only">Treść dokumentu</h2>

        {{#each sections}}
        <section id="section-{{@index}}" role="region" aria-labelledby="heading-{{@index}}">
            <h2 id="heading-{{@index}}">{{heading}}</h2>
            <p>{{text}}</p>

            {{!-- OBRAZKI --}}
            {{#if image}}
            <figure role="group" aria-labelledby="figcaption-{{@index}}" style="min-height:200px;">
                <img src="{{image.src}}" alt="{{image.alt}}" role="img" aria-describedby="figcaption-{{@index}}"
                    style="width:400px; min-height:150px;">
                <figcaption id="figcaption-{{@index}}">{{image.caption}}</figcaption>
            </figure>
            {{/if}}

            {{!-- TABELA --}}
            {{#if table}}
            <table role="table" aria-label="{{table.caption}}">
                <caption>{{table.caption}}</caption>
                <thead>
                    <tr>
                        {{#each table.headers}}<th scope="col">{{this}}</th>{{/each}}
                    </tr>
                </thead>
                <tbody>
                    {{#each table.rows}}
                    <tr>
                        {{#each this}}<td>{{this}}</td>{{/each}}
                    </tr>
                    {{/each}}
                </tbody>
            </table>
            {{/if}}

            {{!-- LISTA --}}
            {{#if list}}
            <div role="region" aria-labelledby="list-heading-{{@index}}">
                <h3 id="list-heading-{{@index}}">{{list.title}}</h3>
                <ul -webkit-pdf-tag-type="L">
                    {{#each list.items}}
                    <li -webkit-pdf-tag-type="LI">
                        <span class="Lbl">&#x2022;&nbsp;</span><span class="LBody">{{this}}</span>
                    </li>
                    {{/each}}
                </ul>
            </div>
            {{/if}}


            {{!-- ASIDE --}}
            {{!-- {{#if aside}}
            <aside role="complementary" aria-label="{{aside.label}}" class="Note">
                <p -webkit-pdf-tag-type="P">{{aside.text}}</p>
            </aside>
            {{/if}} --}}

        </section>
        {{/each}}
    </main>
</body>

</html>